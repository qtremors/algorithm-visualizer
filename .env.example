# Backend defaults. Runtime variables may override these; uvicorn does not load
# this file automatically. Export values in the shell or use --env-file .env.
# Empty/unset ALLOWED_ORIGINS permits public access. Set explicit origins to
# restrict BOTH HTTP CORS and WebSockets. Include the scheme and optional port.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ARRAY_SIZE=100
MAX_GRID_ROWS=50
MAX_GRID_COLS=50
MAX_GRAPH_NODES=50
MAX_GRAPH_EDGES=500
MAX_INPUT_BYTES=65536
MAX_STEPS=12000
MAX_TRACE_BYTES=16777216
INPUT_TIMEOUT_SECONDS=5
EXECUTION_TIMEOUT_SECONDS=10
MAX_CONNECTIONS=8
MAX_CONNECTIONS_PER_IP=2
CONNECTIONS_PER_MINUTE=20
